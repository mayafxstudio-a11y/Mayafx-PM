# ===== Mayafx HQ settings — copy to .env, fill in, keep PRIVATE =====

# HQ (your Google Sheet backend) — same values as HQ/PM Settings
HQ_SHEET_URL=https://script.google.com/macros/s/XXXX/exec
HQ_KEY=same-KEY-as-in-Code.gs

# AI brains: laptop first (fast), desktop backup is automatic
LAPTOP_OLLAMA_URL=http://192.168.1.50:11434
HQ_MODEL=mayafx-hq

# n8n: Settings -> n8n API -> Create API key (lets the AI find workflows tagged "hq")
N8N_API_KEY=

# Telegram: @BotFather -> /newbot. Leave CHAT_ID empty, message the bot once, it tells you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> create -> route hq-ai.yourdomain.com to http://hq-ai:8787)
TUNNEL_TOKEN=

# Who may use the AI from a browser
ALLOWED_ORIGINS=https://mayafxstudio-a11y.github.io
