{
  "name": "HQ · Briefs (9 AM · 2 PM · 8 PM · 11 PM)",
  "nodes": [
    {
      "id": "23d59efb-9458-40d0-9bc7-7bd50bc0b94e",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        80
      ],
      "parameters": {
        "content": "## HQ Briefs\nAsks the HQ AI for a summary at 9 AM, 2 PM, 8 PM and 11 PM and sends it to Telegram.\nChange times in the Schedule node.",
        "width": 340,
        "height": 200
      }
    },
    {
      "id": "0be1f9f3-7cc1-44a9-bf9e-b32be93c4aad",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        320
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            },
            {
              "field": "cronExpression",
              "expression": "0 14 * * *"
            },
            {
              "field": "cronExpression",
              "expression": "0 20 * * *"
            },
            {
              "field": "cronExpression",
              "expression": "0 23 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "be720850-bac3-4d6c-bb5a-a0d755ec0d9b",
      "name": "Ask HQ AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "http://hq-ai:8787/api/summary",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slot: \"auto\" }) }}",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HQ-Key",
              "value": "={{ $env.HQ_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "705fa7cd-0f6a-4cb8-9e6a-324b635abaf9",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text }) }}",
        "options": {
          "timeout": 300000
        }
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Ask HQ AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask HQ AI": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "tags": [],
  "pinData": {}
}