{
  "name": "HQ · To-do Reminders (every 10 min)",
  "nodes": [
    {
      "id": "9ba7cdff-0676-4617-8738-0d4e12374ed8",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        80
      ],
      "parameters": {
        "content": "## To-do reminders\nEvery 10 minutes: any HQ to-do whose 'Remind me at' time has come is sent to Telegram once, then marked reminded.",
        "width": 340,
        "height": 200
      }
    },
    {
      "id": "8c307790-06d9-42bd-a0d5-0ce5623e20ef",
      "name": "Every 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        320
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "0f2a83aa-179d-4a6b-a9ac-c8500ac8fd2d",
      "name": "Due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "http://hq-ai:8787/api/reminders/due",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HQ-Key",
              "value": "={{ $env.HQ_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "6669aff3-e3bb-44d1-a2ef-46726d81a680",
      "name": "One per reminder",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        320
      ],
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      }
    },
    {
      "id": "5582c1c1-04cf-4faf-bbe7-c5a368d7333f",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text }) }}",
        "options": {
          "timeout": 300000
        }
      }
    }
  ],
  "connections": {
    "Every 10 min": {
      "main": [
        [
          {
            "node": "Due reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Due reminders": {
      "main": [
        [
          {
            "node": "One per reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One per reminder": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "tags": [],
  "pinData": {}
}